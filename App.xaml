<Application x:Class="_6TTI_DPMael_WPFMultiPage.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_6TTI_DPMael_WPFMultiPage"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ============================================================
             PALETTE NÉON "WHAT THE FUCK"
             ============================================================ -->
        <Color x:Key="HotPink">#FF00C8</Color>
        <Color x:Key="AcidLime">#B6FF00</Color>
        <Color x:Key="ElectricCyan">#00F5FF</Color>
        <Color x:Key="UltraViolet">#8A2BFF</Color>
        <Color x:Key="LaserOrange">#FF5E00</Color>
        <Color x:Key="ToxicYellow">#FFF200</Color>
        <Color x:Key="BloodRed">#FF003C</Color>
        <Color x:Key="RadioactiveGreen">#00FF6A</Color>
        <Color x:Key="VoidPurple">#14001F</Color>
        <Color x:Key="AbyssBlue">#000B2E</Color>
        <Color x:Key="SludgeGreen">#071A00</Color>

        <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidPurple}" />

        <!-- Glows réutilisables -->
        <DropShadowEffect x:Key="GlowPink" Color="{StaticResource HotPink}" BlurRadius="25" ShadowDepth="0" Opacity="1" />
        <DropShadowEffect x:Key="GlowCyan" Color="{StaticResource ElectricCyan}" BlurRadius="25" ShadowDepth="0" Opacity="1" />
        <DropShadowEffect x:Key="GlowLime" Color="{StaticResource AcidLime}" BlurRadius="30" ShadowDepth="0" Opacity="1" />

        <!-- ============================================================
             FENÊTRE : fond psychédélique qui bouge en permanence
             ============================================================ -->
        <Style x:Key="WtfWindow" TargetType="Window">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource VoidPurple}" Offset="0" />
                        <GradientStop Color="{StaticResource UltraViolet}" Offset="0.5" />
                        <GradientStop Color="{StaticResource AbyssBlue}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Window.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                            From="{StaticResource UltraViolet}" To="{StaticResource HotPink}"
                                            Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(Window.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)"
                                            From="{StaticResource AbyssBlue}" To="#004D4D"
                                            Duration="0:0:3" AutoReverse="True" RepeatBehavior="Forever" />
                            <PointAnimation Storyboard.TargetProperty="(Window.Background).(LinearGradientBrush.StartPoint)"
                                            From="0,0" To="1,0" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever" />
                            <PointAnimation Storyboard.TargetProperty="(Window.Background).(LinearGradientBrush.EndPoint)"
                                            From="1,1" To="0,1" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================
             TEXTES
             ============================================================ -->

        <!-- Base commune : gros, gras, qui brille -->
        <Style x:Key="WtfTextBase" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Impact, Arial Black" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Effect" Value="{StaticResource GlowPink}" />
        </Style>

        <!-- Titre arc-en-ciel qui change de couleur ET qui gigote -->
        <Style x:Key="WtfTitle" TargetType="TextBlock" BasedOn="{StaticResource WtfTextBase}">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="-3" />
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{StaticResource ElectricCyan}" BlurRadius="20" ShadowDepth="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource HotPink}" Offset="0" />
                        <GradientStop Color="{StaticResource ToxicYellow}" Offset="0.33" />
                        <GradientStop Color="{StaticResource ElectricCyan}" Offset="0.66" />
                        <GradientStop Color="{StaticResource AcidLime}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="-3" To="3" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                            To="{StaticResource LaserOrange}" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                            To="{StaticResource HotPink}" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[2].(GradientStop.Color)"
                                            To="{StaticResource RadioactiveGreen}" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[3].(GradientStop.Color)"
                                            To="{StaticResource UltraViolet}" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)"
                                            To="{StaticResource HotPink}" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Accueil : arc-en-ciel total -->
        <Style x:Key="WtfRainbowText" TargetType="TextBlock" BasedOn="{StaticResource WtfTextBase}">
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource BloodRed}" Offset="0" />
                        <GradientStop Color="{StaticResource ToxicYellow}" Offset="0.25" />
                        <GradientStop Color="{StaticResource RadioactiveGreen}" Offset="0.5" />
                        <GradientStop Color="{StaticResource ElectricCyan}" Offset="0.75" />
                        <GradientStop Color="{StaticResource HotPink}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                            To="{StaticResource HotPink}" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[2].(GradientStop.Color)"
                                            To="{StaticResource UltraViolet}" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[4].(GradientStop.Color)"
                                            To="{StaticResource ToxicYellow}" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Page 1 : cyberpunk cyan / rose -->
        <Style x:Key="WtfCyberText" TargetType="TextBlock" BasedOn="{StaticResource WtfTextBase}">
            <Setter Property="Effect" Value="{StaticResource GlowCyan}" />
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource ElectricCyan}" Offset="0" />
                        <GradientStop Color="White" Offset="0.5" />
                        <GradientStop Color="{StaticResource HotPink}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                            To="{StaticResource HotPink}" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[2].(GradientStop.Color)"
                                            To="{StaticResource ElectricCyan}" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Page 2 : déchet toxique lime / orange -->
        <Style x:Key="WtfToxicText" TargetType="TextBlock" BasedOn="{StaticResource WtfTextBase}">
            <Setter Property="Effect" Value="{StaticResource GlowLime}" />
            <Setter Property="Foreground">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource AcidLime}" Offset="0" />
                        <GradientStop Color="{StaticResource ToxicYellow}" Offset="0.5" />
                        <GradientStop Color="{StaticResource LaserOrange}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                            To="{StaticResource LaserOrange}" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[2].(GradientStop.Color)"
                                            To="{StaticResource RadioactiveGreen}" Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================
             BOUTONS : néon qui s'inverse au survol
             ============================================================ -->
        <Style x:Key="WtfButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Impact, Arial Black" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource VoidBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource HotPink}" Offset="0" />
                        <GradientStop Color="{StaticResource ToxicYellow}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource ElectricCyan}" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"
                                CornerRadius="14"
                                RenderTransformOrigin="0.5,0.5"
                                Effect="{StaticResource GlowPink}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{StaticResource ElectricCyan}" Offset="0" />
                                            <GradientStop Color="{StaticResource UltraViolet}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AcidLime}" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Effect" Value="{StaticResource GlowLime}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.93" ScaleY="0.93" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource BloodRed}" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             THÈMES DES PAGES (fond animé différent pour chaque page)
             ============================================================ -->

        <!-- Accueil : explosion violet / rose en radial -->
        <Style x:Key="WtfPageAccueil" TargetType="Page">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="{StaticResource HotPink}" Offset="0" />
                        <GradientStop Color="{StaticResource UltraViolet}" Offset="0.45" />
                        <GradientStop Color="{StaticResource VoidPurple}" Offset="1" />
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <PointAnimation Storyboard.TargetProperty="(Page.Background).(RadialGradientBrush.GradientOrigin)"
                                            From="0.2,0.3" To="0.8,0.7" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(Page.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                            To="{StaticResource LaserOrange}" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Page 1 : cyberpunk bleu abyssal / cyan -->
        <Style x:Key="WtfPageCyber" TargetType="Page">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource AbyssBlue}" Offset="0" />
                        <GradientStop Color="#2A0060" Offset="0.6" />
                        <GradientStop Color="{StaticResource HotPink}" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(Page.Background).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                             From="0.4" To="0.85" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(Page.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)"
                                            To="{StaticResource ElectricCyan}" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Page 2 : bain d'acide vert / orange -->
        <Style x:Key="WtfPageToxic" TargetType="Page">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                        <GradientStop Color="{StaticResource SludgeGreen}" Offset="0" />
                        <GradientStop Color="#1F5C00" Offset="0.5" />
                        <GradientStop Color="#3D1400" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Page.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                            To="#5C2A00" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
                            <ColorAnimation Storyboard.TargetProperty="(Page.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)"
                                            To="#004D1A" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
